{
  "name": "evolver-opencode-plugin",
  "version": "0.2.0",
  "description": "Official EvoMap Evolver plugin for OpenCode: recalls a proven strategy behind each prompt, reports its reuse at turn end, and distills verified work outside the conversation.",
  "type": "module",
  "main": "./src/server.js",
  "exports": {
    "./server": "./src/server.js",
    "./tui": "./src/tui.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "evolver-opencode-plugin": "scripts/install.js"
  },
  "files": [
    "src/",
    "assets/",
    "scripts/install.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node scripts/install.js --verify --config-root .",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "evomap",
    "evolver",
    "gep",
    "agent-memory",
    "self-improvement"
  ],
  "author": {
    "name": "EvoMap",
    "email": "team@evomap.ai",
    "url": "https://evomap.ai"
  },
  "homepage": "https://evomap.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvoMap/evolver-opencode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/EvoMap/evolver-opencode-plugin/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.3",
    "opencode": ">=1.19.4"
  }
}
